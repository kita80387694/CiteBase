        "text": "Ember cooling log: natural cooling observations are recorded every 30 minutes\nuntil unloading is permitted.",
        "score": 0.023824701085686684,
        "endOffset": 107,
        "paragraph": 1,
        "versionId": "57a166d3-fb44-4a72-b364-15157bb1a501",
