{
  "topK": 5,
  "fusion": "keyword-vector RRF",
  "chunking": {
    "details": "dataVersions contains actual chunk_strategy/chunk_size/chunk_overlap",
    "strategy": "per-active-document-version",
    "offsetUnit": "UTF-16"
  },
  "provider": {
    "provider": "OpenAI-compatible via Spring AI",
    "chatEndpoint": "https://api.siliconflow.cn",
    "timeoutSeconds": 60,
    "springAiVersion": "1.1.8",
    "embeddingEndpoint": "https://api.siliconflow.cn"
  },
  "reranker": {
    "model": "BAAI/bge-reranker-v2-m3",
    "endpoint": "https://api.siliconflow.cn",
    "provider": "SiliconFlow-compatible /v1/rerank",
    "configured": true,
    "timeoutSeconds": 10
  },
  "chatModel": "deepseek-ai/DeepSeek-V3.2",
  "modelMode": "real",
  "candidateK": 40,
  "concurrency": 2,
  "rrfConstant": 60,
  "temperature": 0,
