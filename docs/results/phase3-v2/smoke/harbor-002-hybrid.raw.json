      },
      {
        "id": "317d9037-f27a-483e-b5d4-d03675dc24a5",
        "page": 4,
        "text": "Harbor recovery card: DQ-RED is cleared only after 5 consecutive valid samples\nfrom the primary probe.",
        "score": 0.7180328369140625,
        "endOffset": 102,
        "paragraph": 1,
        "versionId": "3ef08927-ab08-4f61-9eb9-74f021f35d64",
        "documentId": "a9fea87d-40ad-45e0-b8aa-7eda316493b8",
