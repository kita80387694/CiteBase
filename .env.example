# Copy to .env for Docker Compose. Never commit real keys.
MODEL_MODE=mock
DB_PASSWORD=citebase-local
# Base URLs are origin/prefix WITHOUT trailing /v1; Spring AI appends /v1/chat/completions or /v1/embeddings.
CHAT_BASE_URL=https://api.siliconflow.cn
CHAT_API_KEY=
CHAT_MODEL=deepseek-ai/DeepSeek-V3.2
EMBEDDING_BASE_URL=https://api.siliconflow.cn
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
MODEL_TIMEOUT_SECONDS=60
# Optional dedicated reranker. Off unless the request explicitly enables rerank.
# Base URL excludes /v1; this does not change embedding or existing indexes.
RERANK_BASE_URL=https://api.siliconflow.cn
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_SECONDS=10
# Optional Agent planner overrides. Empty values reuse CHAT_* (DeepSeek by default).
# Final answering still uses CHAT_*; embedding/index identity is unchanged.
AGENT_CHAT_BASE_URL=
AGENT_CHAT_API_KEY=
AGENT_CHAT_MODEL=
# Optional local port overrides when other processes already use default ports:
# WEB_PORT=5173
# API_PORT=8080
# DB_PORT=5432

# Durable worker: concurrency is per JVM, not a cluster-wide model budget.
WORKER_ENABLED=true
TASK_WORKER_CONCURRENCY=2
TASK_LEASE_SECONDS=30
TASK_HEARTBEAT_SECONDS=5
TASK_MAX_ATTEMPTS=3
TASK_POLL_MILLIS=500
TASK_RETRY_DELAY_SECONDS=3
